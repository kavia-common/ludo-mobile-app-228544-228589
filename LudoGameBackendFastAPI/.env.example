# --- Core service ---
LOG_LEVEL=INFO

# --- PostgreSQL ---
# Required for persistence & migrations
# App runtime accepts postgresql://... or postgresql+asyncpg://...
POSTGRES_URL=postgresql+asyncpg://user:password@host:5432/ludo_game_backend

# --- Redis ---
# Required for sessions and match state cache
REDIS_URL=redis://:password@host:6379/0
