# LudoGameBackendFastAPI - example environment configuration
# Copy to .env for local development. Do NOT commit real secrets.

# --- App ---
APP_NAME="Ludo Game Backend"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
ENABLE_REQUEST_LOGGING="true"

# --- Network ---
HOST="0.0.0.0"
PORT="3001"

# --- CORS ---
ALLOWED_ORIGINS="*"
ALLOWED_METHODS="*"
ALLOWED_HEADERS="*"
CORS_ALLOW_CREDENTIALS="true"
CORS_MAX_AGE="3600"

# --- Persistence / cache ---
# Use SQLAlchemy async driver URLs. Examples:
# POSTGRES_URL="postgresql+asyncpg://user:pass@localhost:5432/ludo_game_backend"
POSTGRES_URL=""
REDIS_URL=""

# --- Auth ---
JWT_SECRET=""
JWT_ISSUER=""
JWT_AUDIENCE=""
JWT_EXP_SECONDS="3600"

# --- Gameplay / fairness ---
# Secret salt for RNG audit hashing. Use a long random string.
RNG_AUDIT_SALT=""

# --- Store / IAP (Step 6) ---
# If disabled, receipts are persisted as "pending" and the API returns clear detail.
IAP_VERIFICATION_ENABLED="false"

# Apple (iOS)
APPLE_IAP_BUNDLE_ID=""
APPLE_IAP_SHARED_SECRET=""
APPLE_IAP_ROOT_CERT_SHA256=""

# Google (Android)
GOOGLE_IAP_PACKAGE_NAME=""
GOOGLE_IAP_SERVICE_ACCOUNT_JSON=""
GOOGLE_IAP_PUBLIC_KEY_B64=""

# Admin stub (optional): if unset, /v1/store/admin/* endpoints are disabled
STORE_ADMIN_KEY=""
